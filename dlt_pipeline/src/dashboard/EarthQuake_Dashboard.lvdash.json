{
  "datasets": [
    {
      "name": "49d2edca",
      "displayName": "Seismic Activity Table Overview",
      "queryLines": [
        "select * from silver.earthquake_data;"
      ],
      "catalog": "dlt_pipeline_dev",
      "schema": "silver"
    },
    {
      "name": "5be955af",
      "displayName": "EarthQuake_Type",
      "queryLines": [
        "SELECT\n",
        "    COUNT(*) AS total_magnitude_bucket,\n",
        "    magnitude_bucket\n",
        "FROM (\n",
        "    SELECT\n",
        "        CASE\n",
        "            WHEN mag < 2 THEN 'Micro (<2)'\n",
        "            WHEN mag >= 2 AND mag < 3 THEN 'Minor (2–3)'\n",
        "            WHEN mag >= 3 AND mag < 4 THEN 'Light (3–4)'\n",
        "            ELSE 'Moderate+ (4+)'\n",
        "        END AS magnitude_bucket\n",
        "    FROM silver.earthquake_data\n",
        ") t\n",
        "GROUP BY magnitude_bucket;"
      ],
      "catalog": "dlt_pipeline_dev",
      "schema": "silver"
    },
    {
      "name": "1aa7dd49",
      "displayName": "Earthquake Events by Country Count",
      "queryLines": [
        "SELECT\n",
        "    COUNT(*) AS event_count,\n",
        "    CASE\n",
        "        WHEN SIZE(SPLIT(place, ', ')) > 1\n",
        "            THEN SPLIT(place, ', ')[1]\n",
        "        ELSE SPLIT(place, ', ')[0]\n",
        "    END AS country\n",
        "FROM silver.earthquake_data\n",
        "GROUP BY\n",
        "    CASE\n",
        "        WHEN SIZE(SPLIT(place, ', ')) > 1\n",
        "            THEN SPLIT(place, ', ')[1]\n",
        "        ELSE SPLIT(place, ', ')[0]\n",
        "    END;"
      ],
      "catalog": "dlt_pipeline_dev",
      "schema": "silver"
    }
  ],
